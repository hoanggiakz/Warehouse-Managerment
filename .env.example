# ==============================================================================
# Maluzen Automotive Parts & Warehouse Management System
# Environment Configuration Template
# ==============================================================================
# NOTE: Never commit real credentials, connection strings, or secrets to version control.
# Copy this file to .env.local for local development.
# ==============================================================================

# [SERVER ONLY] Pooled Neon PostgreSQL connection URL (used by application runtime)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# [SERVER ONLY] Direct Neon PostgreSQL connection URL (used by Prisma CLI for migrations)
# Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=

# [SERVER ONLY] Secret key for signing and verifying JWT session cookies
# Generate a secure random string: openssl rand -base64 32
AUTH_SECRET=

# [SERVER ONLY] Node environment (development | production | test)
NODE_ENV=development
